<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>streamfusion-parquet</artifactId>
    <name>StreamFusion Parquet</name>
    <properties>
        <native.cargo.packages>-p streamfusion-parquet</native.cargo.packages>
        <native.library>streamfusion_parquet</native.library>
        <native.resource.path>tech/streamfusion/native/parquet</native.resource.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
        <resources combine.self="override">
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${native.resource.directory}</directory>
                <targetPath>${native.resource.path}</targetPath>
                <includes>
                    <include>lib${native.library}.so</include>
                    <include>lib${native.library}.dylib</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration><includes>
                    <include>tech/streamfusion/parquet/**/*.java</include>
                    <include>tech/streamfusion/operator/NativeParquetBulkWriterFactory.java</include>
                    <include>tech/streamfusion/operator/NativeParquetRollingPolicy.java</include>
                    <include>tech/streamfusion/operator/ParquetPartitionSplitOperator.java</include>
                    <include>tech/streamfusion/planner/NativeParquetSinkExecNode.java</include>
                    <include>tech/streamfusion/planner/ParquetPlannerExtension.java</include>
                    <include>tech/streamfusion/planner/ParquetSinkMatcher.java</include>
                    <include>tech/streamfusion/planner/ParquetSinkTranslator.java</include>
                    <include>tech/streamfusion/planner/StreamPhysicalNativeParquetSink.java</include>
                </includes></configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Universal releases package the payloads staged for each supported platform. -->
    <profiles>
        <profile>
            <id>universal</id>
            <build>
                <resources>
                    <resource>
                        <directory>${project.basedir}/../native/target/universal/parquet</directory>
                        <targetPath>tech/streamfusion/native/parquet</targetPath>
                        <includes>
                            <include>**/libstreamfusion_parquet.so</include>
                            <include>**/libstreamfusion_parquet.dylib</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
