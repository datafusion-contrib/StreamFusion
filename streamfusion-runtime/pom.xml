<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>streamfusion-runtime${streamfusion.artifact.suffix}</artifactId>
    <name>StreamFusion Runtime</name>

    <properties>
        <native.cargo.packages>--workspace</native.cargo.packages>
        <sf.orc.test.groups>streamfusion-orc</sf.orc.test.groups>
        <skipTests>false</skipTests>
        <sf.runtime.tests.skip>${skipTests}</sf.runtime.tests.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-test-utils${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version><type>test-jar</type><scope>test</scope>
        </dependency>

        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-kafka${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-json${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-csv${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-raw${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-avro${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-avro-confluent-registry${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-protobuf${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-parquet${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-orc${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Integration tests consume the deployable modules without duplicating their production classes. -->
    <build>
        <resources combine.self="override">
            <!-- The all-in-one development/test assembly exposes every optional planner provider.
                 Deployable artifacts carry only their own provider file. -->
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${native.resource.directory}</directory>
                <targetPath>tech/streamfusion/native</targetPath>
                <includes>
                    <include>libstreamfusion.so</include>
                    <include>libstreamfusion.dylib</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../native/engine/tests/fixtures</directory>
                <includes><include>retracting-rank/*.json</include></includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration><flattenMode>ossrh</flattenMode></configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>flink-compatibility-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration><sources>
                            <source>${project.basedir}/src/test/java-flink${flink.line}</source>
                        </sources></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Publish the resource-only development assembly and integration fixtures early,
                 so opt-in connector benchmarks can consume them inside the reactor. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <!-- Reusing the default execution avoids a second package-phase JAR. -->
                        <phase>process-classes</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                    <execution>
                        <id>test-jar</id>
                        <!-- Shared correctness and Nexmark fixture contracts remain available to local
                             connector benchmark profiles on the early reactor schedule. -->
                        <phase>process-test-classes</phase>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${sf.runtime.tests.skip}</skipTests>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludedGroups>streamfusion-orc</excludedGroups>
                            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                    <!-- Flink's ORC 1.5.6 uses protobuf 2.5. Its upstream format suite has a
                         separate classpath from Flink's protobuf-4 format; mirror that here. -->
                    <execution>
                        <id>orc-tests</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <groups>${sf.orc.test.groups}</groups>
                            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>com.google.protobuf:protobuf-java</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <additionalClasspathDependencies>
                                <additionalClasspathDependency>
                                    <groupId>com.google.protobuf</groupId>
                                    <artifactId>protobuf-java</artifactId>
                                    <version>2.5.0</version>
                                </additionalClasspathDependency>
                            </additionalClasspathDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>flink-1.18</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-api-scala-bridge_${scala.binary.version}</artifactId>
                    <version>${flink.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>tpch</id>
            <dependencies>
                <dependency>
                    <groupId>io.airlift.tpch</groupId><artifactId>tpch</artifactId>
                    <version>0.10</version><scope>test</scope>
                </dependency>
            </dependencies>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
                <executions><execution><id>tpch-test-source</id><phase>generate-test-sources</phase>
                    <goals><goal>add-test-source</goal></goals><configuration><sources>
                        <source>${project.basedir}/src/tpch/java</source>
                    </sources></configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>batch-upstream</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-common</artifactId>
                    <version>${flink.version}</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-planner_${scala.binary.version}</artifactId>
                    <version>${flink.version}</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                    <version>${junit.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><dependenciesToScan>
                    <dependency>org.apache.flink:flink-table-planner_${scala.binary.version}</dependency>
                </dependenciesToScan></configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>canonical-kafka</id>
            <dependencies>
                <dependency>
                    <groupId>tech.streamfusion</groupId>
                    <artifactId>streamfusion-json${streamfusion.artifact.suffix}</artifactId>
                    <version>${project.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>partition-runtime-tests</id>
            <activation><property><name>sf.runtime.testIncludesFile</name></property></activation>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includesFile>${sf.runtime.testIncludesFile}</includesFile>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>filter-orc-test-groups</id>
            <activation><property><name>groups</name></property></activation>
            <properties>
                <!-- Preserve the caller's tag selection in the isolated ORC execution. -->
                <sf.orc.test.groups>streamfusion-orc &amp; (${groups})</sf.orc.test.groups>
            </properties>
        </profile>
    </profiles>
</project>
