<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.streamfusion</groupId>
    <artifactId>StreamFusion</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>streamfusion-doris${streamfusion.artifact.suffix}</artifactId>
  <name>StreamFusion Doris</name>
  <properties>
    <doris.connector.version>26.3.0</doris.connector.version>
    <native.test.resource.skip>true</native.test.resource.skip>
    <doris.upstream.reports>${project.build.directory}/doris-suite/upstream-reports</doris.upstream.reports>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>tech.streamfusion</groupId>
      <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.doris</groupId>
      <artifactId>flink-doris-connector-${flink.line}</artifactId>
      <version>${doris.connector.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-python</artifactId>
      <version>${flink.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources combine.self="override">
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>..</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <configuration><includes>
          <include>tech/streamfusion/doris/**/*.java</include>
          <include>tech/streamfusion/planner/*Doris*.java</include>
        </includes></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration><sourceFileIncludes>
          <sourceFileInclude>tech/streamfusion/doris/**/*.java</sourceFileInclude>
          <sourceFileInclude>tech/streamfusion/planner/*Doris*.java</sourceFileInclude>
        </sourceFileIncludes></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions><execution><id>java-11-compatibility</id><configuration><rules>
          <requireJavaVersion><version>[17,)</version></requireJavaVersion>
          <requireProperty>
            <property>flink.line</property><regex>2\.2</regex>
            <regexMessage>The Doris Arrow adapter currently targets Flink 2.2.</regexMessage>
          </requireProperty>
          <enforceBytecodeVersion><maxJdkVersion>17</maxJdkVersion></enforceBytecodeVersion>
        </rules></configuration></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration><flattenMode>ossrh</flattenMode></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><includes>
          <include>tech/streamfusion/doris/**/*.java</include>
          <include>tech/streamfusion/planner/*Doris*.java</include>
        </includes></configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>doris-upstream</id>
      <dependencies>
        <dependency>
          <groupId>org.apache.doris</groupId><artifactId>flink-doris-connector-${flink.line}</artifactId>
          <version>${doris.connector.version}</version><type>test-jar</type><scope>test</scope>
          <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
          <groupId>org.apache.doris</groupId><artifactId>flink-doris-connector-base</artifactId>
          <version>${doris.connector.version}</version><type>test-jar</type><scope>test</scope>
          <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId><artifactId>flink-test-utils</artifactId>
          <version>${flink.version}</version><scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId><artifactId>flink-runtime</artifactId>
          <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId><artifactId>flink-table-common</artifactId>
          <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.junit.vintage</groupId><artifactId>junit-vintage-engine</artifactId>
          <version>${junit.version}</version><scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.testcontainers</groupId><artifactId>mysql</artifactId>
          <version>1.21.4</version><scope>test</scope>
        </dependency>
      </dependencies>
      <build><plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
          <executions><execution>
            <id>doris-upstream-test-sources</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
            <configuration><sources>
              <source>${project.basedir}/target/upstream-test-sources</source>
            </sources></configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
          <configuration><testIncludes>
            <testInclude>tech/streamfusion/doris/**/*.java</testInclude>
            <testInclude>tech/streamfusion/planner/*Doris*Test.java</testInclude>
            <testInclude>org/apache/doris/flink/source/DorisSourceITCase.java</testInclude>
            <testInclude>org/apache/doris/flink/source/*DorisIncremental*.java</testInclude>
            <testInclude>org/apache/doris/flink/sink/DorisSinkITCase.java</testInclude>
            <testInclude>org/apache/doris/flink/catalog/DorisCatalogITCase.java</testInclude>
            <testInclude>org/apache/doris/flink/lookup/DorisLookupTableITCase.java</testInclude>
            <testInclude>org/apache/doris/flink/table/DorisRowDataJdbcLookupFunctionITCase.java</testInclude>
          </testIncludes></configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
          <configuration><reportsDirectory>${doris.upstream.reports}</reportsDirectory><includes>
            <include>**/DorisSourceITCase.java</include>
            <include>**/DorisSinkITCase.java</include>
            <include>**/DorisCatalogITCase.java</include>
            <include>**/DorisLookupTableITCase.java</include>
            <include>**/DorisRowDataJdbcLookupFunctionITCase.java</include>
          </includes></configuration>
        </plugin>
      </plugins></build>
    </profile>
    <profile>
      <id>doris-it</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration><includes>
          <include>**/*Test.java</include>
          <include>**/*IT.java</include>
        </includes></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
