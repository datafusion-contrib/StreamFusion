<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.streamfusion</groupId>
    <artifactId>StreamFusion</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>streamfusion-starrocks${streamfusion.artifact.suffix}</artifactId>
  <name>StreamFusion StarRocks</name>
  <properties>
    <starrocks.connector.version>1.2.16_flink-${flink.line}</starrocks.connector.version>
    <native.cargo.packages>-p streamfusion-starrocks</native.cargo.packages>
    <native.library>streamfusion_starrocks</native.library>
    <native.resource.path>tech/streamfusion/native/starrocks</native.resource.path>
  </properties>
  <dependencies>
    <dependency>
      <groupId>tech.streamfusion</groupId>
      <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.starrocks</groupId>
      <artifactId>flink-connector-starrocks</artifactId>
      <version>${starrocks.connector.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources combine.self="override">
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>..</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include></includes></resource>
      <resource>
        <directory>${native.resource.directory}</directory>
        <targetPath>${native.resource.path}</targetPath>
        <includes>
          <include>lib${native.library}.so</include>
          <include>lib${native.library}.dylib</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <configuration><includes>
          <include>tech/streamfusion/starrocks/**/*.java</include>
          <include>tech/streamfusion/planner/*StarRocks*.java</include>
        </includes></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration><sourceFileIncludes>
          <sourceFileInclude>tech/streamfusion/starrocks/**/*.java</sourceFileInclude>
          <sourceFileInclude>tech/streamfusion/planner/*StarRocks*.java</sourceFileInclude>
        </sourceFileIncludes></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions><execution><id>java-11-compatibility</id><configuration><rules>
          <requireProperty>
            <property>flink.line</property><regex>1\.18</regex>
            <regexMessage>The released StarRocks connector has no Flink 2.x artifact; build with -Pflink-1.18.</regexMessage>
          </requireProperty>
        </rules></configuration></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration><flattenMode>ossrh</flattenMode></configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><includes>
          <include>tech/streamfusion/starrocks/**/*.java</include>
          <include>tech/streamfusion/planner/*StarRocks*.java</include>
        </includes></configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>starrocks-upstream</id>
      <properties>
        <starrocks.upstream.reports>${project.build.directory}/surefire-reports</starrocks.upstream.reports>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.junit.vintage</groupId><artifactId>junit-vintage-engine</artifactId>
          <version>${junit.version}</version><scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId>
          <version>1.21.4</version><scope>test</scope>
        </dependency>
        <!-- The released Kafka-to-StarRocks IT compiles against Flink's own table test utilities. -->
        <dependency>
          <groupId>org.apache.flink</groupId><artifactId>flink-table-planner_${scala.binary.version}</artifactId>
          <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.flink</groupId><artifactId>flink-table-common</artifactId>
          <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
        </dependency>
      </dependencies>
      <build><plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>starrocks-upstream-test-sources</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
              <configuration><sources>
                <source>${project.basedir}/target/upstream-test-sources</source>
              </sources></configuration>
            </execution>
            <execution>
              <id>starrocks-upstream-test-resources</id><phase>generate-test-resources</phase><goals><goal>add-test-resource</goal></goals>
              <configuration><resources>
                <resource><directory>${project.basedir}/target/upstream-test-resources</directory></resource>
              </resources></configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
          <configuration><reportsDirectory>${starrocks.upstream.reports}</reportsDirectory><includes>
            <include>**/StarRocksSinkITTest.java</include>
            <include>**/KafkaToStarRocksITTest.java</include>
          </includes></configuration>
        </plugin>
      </plugins></build>
    </profile>
    <profile>
      <id>starrocks-it</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration><includes>
          <include>**/*Test.java</include>
          <include>**/*IT.java</include>
        </includes></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>universal</id>
      <build>
        <resources>
          <resource>
            <directory>${project.basedir}/../native/target/universal/starrocks</directory>
            <targetPath>tech/streamfusion/native/starrocks</targetPath>
            <includes>
              <include>**/libstreamfusion_starrocks.so</include>
              <include>**/libstreamfusion_starrocks.dylib</include>
            </includes>
          </resource>
        </resources>
      </build>
    </profile>
  </profiles>
</project>
