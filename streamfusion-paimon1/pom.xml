<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>streamfusion-paimon1${streamfusion.artifact.suffix}</artifactId>
    <name>StreamFusion Paimon 1.0</name>
    <properties>
        <paimon.version>1.0.0</paimon.version>
        <native.cargo.packages>-p streamfusion -p streamfusion-parquet -p streamfusion-orc -p streamfusion-paimon</native.cargo.packages>
        <native.library>streamfusion_paimon</native.library>
        <native.resource.path>tech/streamfusion/native/paimon</native.resource.path>
    </properties>
    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-runtime${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-kafka${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-json${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-parquet${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-orc${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-flink-${flink.line}</artifactId>
            <version>${paimon.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>3.3.4</version>
            <scope>provided</scope>
            <exclusions>
                <!-- Hadoop's log4j 1.x bindings would win SLF4J's binding lookup over Flink's log4j2
                     test binding and leave every logger at DEBUG, which makes parquet-mr wrap the
                     stock Paimon writer in per-value record logging and distorts the benchmark. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.reload4j</groupId>
                    <artifactId>reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <testSourceDirectory>${project.build.directory}/generated-test-sources/paimon</testSourceDirectory>
        <sourceDirectory>${project.build.directory}/generated-sources/paimon</sourceDirectory>
        <resources combine.self="override">
            <resource>
                <directory>${project.basedir}/..</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${native.resource.directory}</directory>
                <targetPath>${native.resource.path}</targetPath>
                <includes>
                    <include>lib${native.library}.so</include>
                    <include>lib${native.library}.dylib</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>flink-compatibility-sources</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <sourceFileExcludes combine.self="override"/>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>shared-paimon-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-sources/paimon</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../src/main/java</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>tech/streamfusion/paimon/**/*.java</include>
                                        <include>tech/streamfusion/planner/*Paimon*.java</include>
                                    </includes>
                                    <excludes>
                                        <exclude>tech/streamfusion/paimon/PaimonVersion.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativeAppendSinkWrite.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativeKeyValueSinkWrite.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonAppendSink.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonBucketAssigner.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonBucketSink.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonCoordinatorCommitOperator.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonDynamicPartitionOperator.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonKeyValueFileWriter.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonLocalMergeOperator.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonOrcFormat.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonParquetFormat.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonPostponeSink.java</exclude>
                                        <exclude>tech/streamfusion/paimon/NativePaimonWriteOperator.java</exclude>
                                        <exclude>tech/streamfusion/paimon/PaimonDynamicBucketIndex.java</exclude>
                                        <exclude>tech/streamfusion/paimon/PaimonKeyValueLayout.java</exclude>
                                        <exclude>tech/streamfusion/paimon/PaimonMergeOptions.java</exclude>
                                        <exclude>tech/streamfusion/paimon/PaimonParquetFloatingStats.java</exclude>
                                        <exclude>tech/streamfusion/paimon/PaimonPostponeFileOrder.java</exclude>
                                        <exclude>tech/streamfusion/planner/NativePaimonSinkExecNode.java</exclude>
                                        <exclude>tech/streamfusion/planner/PaimonSinkMatcher.java</exclude>
                                        <exclude>tech/streamfusion/planner/PaimonSourceMatcher.java</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/src/main/java</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>shared-paimon-tests</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-test-sources/paimon</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../streamfusion-paimon/src/test/java</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>**/PaimonSourceSqlTest.java</include>
                                        <include>**/PaimonSplitWatermarksTest.java</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/src/test/java</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>legacy-flink-line</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>flink.line</property>
                                    <regex>1\.18</regex>
                                    <message>Paimon 1.0.0 requires the flink-1.18 profile.</message>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <user.timezone>UTC</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <includes>
                        <include>tech/streamfusion/paimon/**/*.java</include>
                        <include>tech/streamfusion/planner/Paimon*.java</include>
                        <include>tech/streamfusion/planner/NativePaimon*.java</include>
                        <include>tech/streamfusion/planner/StreamPhysicalNativePaimon*.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>upstream-paimon1</id>
            <properties>
                <sf.testForks>1</sf.testForks>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.paimon</groupId>
                    <artifactId>paimon-flink-common</artifactId>
                    <version>1.0.0</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId>
                    <artifactId>paimon-core</artifactId>
                    <version>1.0.0</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId>
                    <artifactId>paimon-common</artifactId>
                    <version>1.0.0</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId>
                    <artifactId>paimon-test-utils</artifactId>
                    <version>1.0.0</version>
                    <type>jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-planner_2.12</artifactId>
                    <version>${flink.version}</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-table-common</artifactId>
                    <version>${flink.version}</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-core</artifactId>
                    <version>${flink.version}</version>
                    <type>test-jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId>
                    <artifactId>paimon-shade-netty-4</artifactId>
                    <version>4.1.100.Final-0.8.0</version>
                    <type>jar</type>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>upstream-flink118-sql-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.build.directory}/upstream-suite/src</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Upstream aggregation ITs are public static nested test classes. -->
                            <excludes>
                                <exclude/>
                            </excludes>
                            <dependenciesToScan>
                                <dependency>org.apache.paimon:paimon-flink-common</dependency>
                            </dependenciesToScan>
                            <systemPropertyVariables>
                                <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
                                <streamfusion.flink-suite.flink-line>1.18</streamfusion.flink-suite.flink-line>
                                <streamfusion.flink-suite.sql-inventory>${project.build.directory}/upstream-suite/inventory</streamfusion.flink-suite.sql-inventory>
                                <streamfusion.flink-suite.native-reports>${project.build.directory}/native-reports</streamfusion.flink-suite.native-reports>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>orc-writer-bench</id>
            <properties>
                <!-- Preserve the ORC module's opt-in comparison payload. -->
                <native.cargo.packages>-p streamfusion-paimon</native.cargo.packages>
            </properties>
        </profile>
        <profile>
            <id>orc-reader-bench</id>
            <properties>
                <!-- Preserve the ORC module's opt-in comparison payload. -->
                <native.cargo.packages>-p streamfusion-paimon</native.cargo.packages>
            </properties>
        </profile>
        <profile>
            <id>universal</id>
            <build>
                <resources>
                    <resource>
                        <directory>${project.basedir}/../native/target/universal/paimon</directory>
                        <targetPath>tech/streamfusion/native/paimon</targetPath>
                        <includes>
                            <include>**/libstreamfusion_paimon.so</include>
                            <include>**/libstreamfusion_paimon.dylib</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
