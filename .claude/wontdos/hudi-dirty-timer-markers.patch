+#[test]
+fn unchanged_pending_timers_do_not_rewrite_rocksdb() {
+    let directory = tempfile::tempdir().unwrap();
+    let mut operator = shared(Some(directory.path()), false, false, true);
+    let key = operator
+        .key_converter
+        .as_ref()
+        .unwrap()
+        .convert_columns(&[Arc::new(Int64Array::from(vec![7])) as ArrayRef])
+        .unwrap()
+        .row(0)
+        .owned();
+    assert!(operator.add_slice_timer(1000, key.clone(), 7).unwrap());
+    assert!(operator.add_slice_timer(2000, key.clone(), 7).unwrap());
+    operator.persist_slice_timers().unwrap();
+    let writes = operator.store.as_ref().unwrap().io_counts().1;
+    assert!(!operator.add_slice_timer(1000, key, 7).unwrap());
+    operator.persist_slice_timers().unwrap();
+    assert_eq!(operator.store.as_ref().unwrap().io_counts().1, writes);
+    assert_eq!(operator.flush(0).unwrap().num_rows(), 0);
+    assert_eq!(operator.store.as_ref().unwrap().io_counts().1, writes);
+    assert_eq!(
+        operator
+            .store
+            .as_ref()
+            .unwrap()
+            .slice_timers()
+            .unwrap()
+            .len(),
+        2
+    );
+}
