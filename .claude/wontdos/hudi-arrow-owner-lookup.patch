+                    barrier.await(10, java.util.concurrent.TimeUnit.SECONDS);
+                    TaskOffHeapMemory.reserveArrow(8);
+                    try {
+                      barrier.await(10, java.util.concurrent.TimeUnit.SECONDS);
+                    } finally {
+                      TaskOffHeapMemory.releaseArrow(8);
+                    }
+                    return null;
+                  }));
+        }
+        for (var future : futures) future.get(20, java.util.concurrent.TimeUnit.SECONDS);
