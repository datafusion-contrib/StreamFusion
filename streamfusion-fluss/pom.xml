<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.streamfusion</groupId>
    <artifactId>StreamFusion</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>streamfusion-fluss${streamfusion.artifact.suffix}</artifactId>
  <name>StreamFusion Fluss</name>
  <properties>
    <fluss.version>1.0.0</fluss.version>
    <native.build.skip>true</native.build.skip>
    <native.test.resource.skip>true</native.test.resource.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>tech.streamfusion</groupId>
      <artifactId>streamfusion-runtime${streamfusion.artifact.suffix}</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>tech.streamfusion</groupId>
      <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.fluss</groupId>
      <artifactId>fluss-flink-${flink.line}</artifactId>
      <version>${fluss.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
    <resources combine.self="override">
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration><flattenMode>ossrh</flattenMode></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <sourceFileIncludes>
            <sourceFileInclude>tech/streamfusion/fluss/**/*.java</sourceFileInclude>
            <sourceFileInclude>tech/streamfusion/planner/*Fluss*.java</sourceFileInclude>
          </sourceFileIncludes>
          <sourceFileExcludes combine.self="override">
            <sourceFileExclude>tech/streamfusion/paimon/**</sourceFileExclude>
            <sourceFileExclude>tech/streamfusion/delta/**</sourceFileExclude>
          </sourceFileExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>tech/streamfusion/fluss/**/*.java</include>
            <include>tech/streamfusion/planner/*Fluss*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
