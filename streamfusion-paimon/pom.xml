<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>streamfusion-paimon${streamfusion.artifact.suffix}</artifactId>
    <name>StreamFusion Paimon</name>
    <properties>
        <native.cargo.packages>-p streamfusion -p streamfusion-parquet -p streamfusion-orc -p streamfusion-paimon</native.cargo.packages>
        <native.library>streamfusion_paimon</native.library>
        <native.resource.path>tech/streamfusion/native/paimon</native.resource.path>
    </properties>
    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-runtime${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-kafka${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-json${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-parquet${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId><artifactId>streamfusion-orc${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version><scope>provided</scope>
        </dependency>
        <!-- The released Paimon connector embeds a newer RowData API. Compile against the host
             Flink API first, including when javac resolves shared projection sources implicitly. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-flink-${flink.line}</artifactId>
            <version>${paimon.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>3.3.4</version>
            <scope>provided</scope>
            <exclusions>
                <!-- Hadoop's log4j 1.x bindings would win SLF4J's binding lookup over Flink's log4j2
                     test binding and leave every logger at DEBUG, which makes parquet-mr wrap the
                     stock Paimon writer in per-value record logging and distorts the benchmark. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.reload4j</groupId>
                    <artifactId>reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
        <resources combine.self="override">
            <resource>
                <directory>${project.basedir}/..</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${native.resource.directory}</directory>
                <targetPath>${native.resource.path}</targetPath>
                <includes>
                    <include>lib${native.library}.so</include>
                    <include>lib${native.library}.dylib</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>paimon-compaction-bridge</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration><sources>
                            <source>${project.basedir}/src/main/java</source>
                        </sources></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration><flattenMode>ossrh</flattenMode></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <user.timezone>UTC</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration><includes>
                    <include>org/apache/paimon/flink/sink/StreamFusionStoreSinkWrite.java</include>
                    <include>tech/streamfusion/paimon/**/*.java</include>
                    <include>tech/streamfusion/planner/Paimon*.java</include>
                    <include>tech/streamfusion/planner/NativePaimon*.java</include>
                    <include>tech/streamfusion/planner/StreamPhysicalNativePaimon*.java</include>
                </includes></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>upstream-paimon-compaction</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.paimon</groupId><artifactId>paimon-core</artifactId>
                    <version>${paimon.version}</version><type>test-jar</type><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId><artifactId>paimon-common</artifactId>
                    <version>${paimon.version}</version><type>test-jar</type><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId><artifactId>paimon-flink-common</artifactId>
                    <version>${paimon.version}</version><type>test-jar</type><scope>test</scope>
                    <exclusions>
                        <exclusion><groupId>org.apache.paimon</groupId><artifactId>paimon-flink1-common</artifactId></exclusion>
                        <exclusion><groupId>org.apache.flink</groupId><artifactId>*</artifactId></exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId><artifactId>paimon-flink2-common</artifactId>
                    <version>${paimon.version}</version><type>test-jar</type><scope>test</scope>
                    <exclusions>
                        <exclusion><groupId>org.apache.flink</groupId><artifactId>*</artifactId></exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId><artifactId>paimon-test-utils</artifactId>
                    <version>${paimon.version}</version><scope>test</scope>
                    <exclusions>
                        <exclusion><groupId>org.apache.flink</groupId><artifactId>*</artifactId></exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId><artifactId>paimon-format</artifactId>
                    <version>${paimon.version}</version><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.paimon</groupId><artifactId>paimon-arrow</artifactId>
                    <version>${paimon.version}</version><scope>test</scope>
                    <exclusions>
                        <exclusion><groupId>org.apache.arrow</groupId><artifactId>*</artifactId></exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.apache.hadoop</groupId><artifactId>hadoop-mapreduce-client-core</artifactId>
                    <version>3.3.4</version><scope>test</scope>
                    <exclusions>
                        <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                        <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-log4j12</artifactId></exclusion>
                        <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                        <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>org.mockito</groupId><artifactId>mockito-inline</artifactId>
                    <version>4.11.0</version><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId><artifactId>flink-streaming-java</artifactId>
                    <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId><artifactId>flink-table-common</artifactId>
                    <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId><artifactId>flink-table-planner_${scala.binary.version}</artifactId>
                    <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId><artifactId>flink-sql-gateway</artifactId>
                    <version>${flink.version}</version><scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId><artifactId>flink-sql-gateway</artifactId>
                    <version>${flink.version}</version><type>test-jar</type><scope>test</scope>
                </dependency>
            </dependencies>
            <build><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
                    <executions><execution>
                        <id>compaction-fixture-flink-line</id><goals><goal>enforce</goal></goals>
                        <configuration><rules><requireProperty>
                            <property>flink.line</property><regex>2\.2</regex>
                            <message>The pinned Paimon compaction fixtures use Flink 2.2.</message>
                        </requireProperty><requireProperty>
                            <property>paimon.version</property><regex>2\.1\.0</regex>
                            <message>The compaction fixture inventory is pinned to released Paimon 2.1.0.</message>
                        </requireProperty></rules></configuration>
                    </execution></executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <forkCount>1</forkCount><reuseForks>false</reuseForks><failIfNoTests>true</failIfNoTests>
                        <dependenciesToScan>
                            <dependency>org.apache.paimon:paimon-core:test-jar:tests</dependency>
                            <dependency>org.apache.paimon:paimon-flink-common:test-jar:tests</dependency>
                        </dependenciesToScan>
                        <includes>
                            <include>**/CompactRewriterFactoryTest.class</include>
                            <include>**/TableWriteTest.class</include>
                            <include>**/KeyValueFileStoreWriteTest.class</include>
                            <include>**/MergeTreeCompactManagerFactoryTest.class</include>
                            <include>**/MergeTreeCompactManagerTest.class</include>
                            <include>**/UniversalCompactionTest.class</include>
                            <include>**/ForceUpLevel0CompactionTest.class</include>
                            <include>**/StoreCompactOperatorTest.class</include>
                            <include>**/CompactRefresherTest.class</include>
                            <include>**/CompactorSinkITCase.class</include>
                            <include>**/CompactActionITCase.class</include>
                            <include>**/MinorCompactActionITCase.class</include>
                            <include>**/CompactProcedureITCase.class</include>
                            <include>**/FullCompactionFileStoreITCase.class</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins></build>
        </profile>
        <profile>
            <id>orc-writer-bench</id>
            <properties>
                <!-- Preserve the ORC module's opt-in comparison payload. -->
                <native.cargo.packages>-p streamfusion-paimon</native.cargo.packages>
            </properties>
        </profile>
        <profile>
            <id>orc-reader-bench</id>
            <properties>
                <!-- Preserve the ORC module's opt-in comparison payload. -->
                <native.cargo.packages>-p streamfusion-paimon</native.cargo.packages>
            </properties>
        </profile>
        <profile>
            <id>universal</id>
            <build>
                <resources>
                    <resource>
                        <directory>${project.basedir}/../native/target/universal/paimon</directory>
                        <targetPath>tech/streamfusion/native/paimon</targetPath>
                        <includes>
                            <include>**/libstreamfusion_paimon.so</include>
                            <include>**/libstreamfusion_paimon.dylib</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
