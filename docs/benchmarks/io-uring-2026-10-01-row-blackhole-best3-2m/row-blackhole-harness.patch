+  @Test
+  @EnabledIfEnvironmentVariable(named = "SF_ROW_ROCKS_BENCH", matches = "true")
+  void rowDataRocksComparison() throws Exception {
+    tableConfigExtras = Map.of(
+        "state.backend.type", "tech.streamfusion.state.RocksDBNativeStateBackendFactory",
+        "table.exec.mini-batch.enabled", "false",
+        "execution.checkpointing.interval", "1 s");
+    System.setProperty("streamfusion.native.enabled", "true");
+    Query q4 = Arrays.stream(ALL_QUERIES).filter(q -> q.label.equals("q4")).findFirst().orElseThrow();
+    AtomicBoolean seen = new AtomicBoolean();
+    Thread watcher = engagementWatcher(seen, () -> Native.liveNativeHandles().contains("Rocks"));
+    try {
+      withProps(q4, true, null, () -> runGeneratorOnce(q4, true));
+    } finally {
+      watcher.interrupt();
+      watcher.join();
+    }
+    if (!seen.get()) {
+      throw new IllegalStateException("Row-data preflight did not engage native RocksDB");
+    }
+    System.out.printf("[native-preflight] RocksDB engaged; rows=%d parallelism=%d checkpoints=1s%n", ROWS, PARALLELISM);
+    try {
+      for (Query q : selectQueries()) {
+        double seconds = generatorBest(q, true, null);
+        System.out.printf("[native-best] %s seconds=%.9f events_per_second=%.3f%n",
+            q.label, seconds, ROWS / seconds);
+      }
+    } finally {
+      tableConfigExtras = Map.of();
+      System.clearProperty("streamfusion.native.enabled");
+    }
+  }
