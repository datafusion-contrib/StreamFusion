+    #[test]
+    fn unbounded_cast_retains_sliced_payload_after_input_drop() {
+        for length in [usize::MAX, i32::MAX as usize] {
+            let cast = BinaryCast {
+                length,
+                pad: false,
+                signature: Signature::any(1, Volatility::Immutable),
+            };
+            for rows in [0, 1, 3] {
+                for all_null in [false, true] {
+                    let input = FixedSizeBinaryArray::try_from_sparse_iter_with_size(
+                        [Some([9, 9]), None, Some([0xff, 0]), Some([0, 0x80])]
+                            .into_iter()
+                            .map(|value| if all_null { None } else { value }),
+                        2,
+                    )
+                    .unwrap()
+                    .slice(1, rows);
+                    let expected = BinaryArray::from_iter(input.iter());
+                    let payload = input.values().as_ptr();
+                    let output = cast.cast(&[Arc::new(input)]).unwrap();
+                    let output = output.as_any().downcast_ref::<BinaryArray>().unwrap();
+                    assert_eq!(output, &expected);
+                    assert_eq!(output.values().as_ptr(), payload);
+                    assert_eq!(
+                        output.value_offsets(),
+                        &(0..=rows as i32).map(|i| i * 2).collect::<Vec<_>>()
+                    );
+                }
+            }
+        }
+    }
