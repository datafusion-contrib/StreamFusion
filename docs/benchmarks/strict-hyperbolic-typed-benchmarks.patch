+};
 use criterion::{criterion_group, criterion_main, BenchmarkId, Criterion, Throughput};
 use std::sync::Arc;
 use streamfusion::bench::CalcProgram;
@@ -113,5 +116,93 @@ fn run(c: &mut Criterion) {
     group.finish();
 }
 
-criterion_group!(benches, run);
+fn typed(c: &mut Criterion) {
+    let oracle: Vec<_> = include_str!("hyperbolic_expressions/java17-typed-oracle.csv")
+        .lines()
+        .skip(1)
+        .map(|line| {
+            let mut fields = line.split(',');
+            let name = fields.next().unwrap();
+            let bits: Vec<_> = fields
+                .map(|field| u64::from_str_radix(field, 16).unwrap())
+                .collect();
+            (name, bits)
+        })
+        .collect();
+    let mut group = c.benchmark_group("hyperbolic_typed_expressions");
+    for input_type in ["i8", "i16", "i32", "i64", "f32"] {
+        let references: Vec<_> = oracle.iter().filter(|row| row.0 == input_type).collect();
+        for (op, name, column) in [(166, "cosh", 2), (167, "sinh", 3), (168, "tanh", 4)] {
+            for rows in [0, 16, 1024, 16384] {
+                for nulls in [false, true] {
+                    for offset in [0, 1, 5] {
+                        let values = (0..rows + offset).map(|i| {
+                            (!(nulls && i % 7 == 0)).then(|| references[i % references.len()].1[0])
+                        });
+                        let input: ArrayRef = match input_type {
+                            "i8" => {
+                                Arc::new(Int8Array::from_iter(values.map(|v| v.map(|b| b as i8))))
+                            }
+                            "i16" => {
+                                Arc::new(Int16Array::from_iter(values.map(|v| v.map(|b| b as i16))))
+                            }
+                            "i32" => {
+                                Arc::new(Int32Array::from_iter(values.map(|v| v.map(|b| b as i32))))
+                            }
+                            "i64" => {
+                                Arc::new(Int64Array::from_iter(values.map(|v| v.map(|b| b as i64))))
+                            }
+                            "f32" => Arc::new(Float32Array::from_iter(
+                                values.map(|v| v.map(|b| f32::from_bits(b as u32))),
+                            )),
+                            _ => unreachable!(),
+                        };
+                        let batch =
+                            RecordBatch::try_from_iter([("value", input.slice(offset, rows))])
+                                .unwrap();
+                        let mut plan = CalcProgram::new(
+                            vec![6, 11, 0],
+                            vec![op, 5, 0],
+                            vec![1, 1, 0],
+                            vec![],
+                            vec![],
+                            vec![],
+                        );
+                        let output = plan.run(batch.clone());
+                        let result = output
+                            .column(0)
+                            .as_any()
+                            .downcast_ref::<Float64Array>()
+                            .unwrap();
+                        assert_eq!(result.len(), rows);
+                        for i in 0..rows {
+                            let source = i + offset;
+                            assert_eq!(result.is_null(i), nulls && source % 7 == 0);
+                            if result.is_valid(i) {
+                                assert_eq!(
+                                    result.value(i).to_bits(),
+                                    references[source % references.len()].1[column],
+                                    "{input_type}/{name}, row={i}, offset={offset}"
+                                );
+                            }
+                        }
+                        let label =
+                            format!("{input_type}/{name}/{rows}/nulls={nulls}/offset={offset}");
+                        let (output, allocations) = measure(|| plan.run(batch.clone()));
+                        report(&label, batch.columns(), output.columns(), allocations);
+                        group.throughput(Throughput::Elements(rows as u64));
+                        group.bench_function(BenchmarkId::from_parameter(label), |b| {
+                            b.iter(|| {
+                                std::hint::black_box(plan.run(std::hint::black_box(batch.clone())))
+                            });
+                        });
+                    }
+                }
+            }
+        }
+    }
+    group.finish();
+}
+
+criterion_group!(benches, run, typed);
 criterion_main!(benches);
