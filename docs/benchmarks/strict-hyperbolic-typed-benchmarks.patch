new file mode 100644
--- /dev/null
+++ b/native/engine/benches/hyperbolic_expressions/TypedHyperbolicOracle.java
@@ -0,0 +1,35 @@
+import java.util.Locale;
+
+public final class TypedHyperbolicOracle {
+  private static void emit(String type, long input, double promoted) {
+    System.out.printf(Locale.ROOT, "%s,%016x,%016x,%016x,%016x,%016x%n", type, input,
+        Double.doubleToRawLongBits(promoted), Double.doubleToRawLongBits(Math.cosh(promoted)),
+        Double.doubleToRawLongBits(Math.sinh(promoted)), Double.doubleToRawLongBits(Math.tanh(promoted)));
+  }
+
+  public static void main(String[] args) {
+    if (Runtime.version().feature() != 17) {
+      throw new IllegalStateException("Generate the reference with released Java 17");
+    }
+    System.out.println("type,input_bits,promoted_bits,cosh_bits,sinh_bits,tanh_bits");
+    for (String type : new String[] {"i8", "i16", "i32", "i64"}) {
+      for (long value = -64; value <= 64; value++) emit(type, value, (double) value);
+      long[] limits = switch (type) {
+        case "i8" -> new long[] {Byte.MIN_VALUE, Byte.MAX_VALUE};
+        case "i16" -> new long[] {Short.MIN_VALUE, Short.MAX_VALUE};
+        case "i32" -> new long[] {Integer.MIN_VALUE, Integer.MAX_VALUE};
+        default -> new long[] {Long.MIN_VALUE, Long.MAX_VALUE, 9007199254740991L,
+            9007199254740992L, 9007199254740993L, -9007199254740993L};
+      };
+      for (long value : limits) emit(type, value, (double) value);
+    }
+    for (int i = -128; i <= 128; i++) {
+      float value = i * 0.1875f;
+      emit("f32", Integer.toUnsignedLong(Float.floatToRawIntBits(value)), (double) value);
+    }
+    for (int bits : new int[] {0, 0x80000000, 1, 0x80000001, 0x00800000, 0x80800000,
+        0x7f7fffff, 0xff7fffff, 0x7f800000, 0xff800000, 0x7fc00000, 0xffc00000}) {
+      emit("f32", Integer.toUnsignedLong(bits), (double) Float.intBitsToFloat(bits));
+    }
+  }
+}
