diff --git a/native/engine/src/flink_functions/hyperbolic.rs b/native/engine/src/flink_functions/hyperbolic.rs
new file mode 100644
--- /dev/null
+++ b/native/engine/src/flink_functions/hyperbolic.rs
@@ -0,0 +1,68 @@
+mod cosh_sinh;
+mod tanh;
+
+use arrow::array::ArrayRef;
+use arrow::datatypes::Float64Type;
+use datafusion::common::{cast::as_primitive_array, exec_err, Result};
+use std::sync::Arc;
+
+fn apply(args: &[ArrayRef], function: fn(f64) -> f64) -> Result<ArrayRef> {
+    if args.len() != 1 {
+        return exec_err!("Hyperbolic functions require one argument");
+    }
+    Ok(Arc::new(
+        as_primitive_array::<Float64Type>(&args[0])?.unary::<_, Float64Type>(function),
+    ))
+}
+pub(super) fn cosh(args: &[ArrayRef]) -> Result<ArrayRef> {
+    apply(args, cosh_sinh::cosh)
+}
+pub(super) fn sinh(args: &[ArrayRef]) -> Result<ArrayRef> {
+    apply(args, cosh_sinh::sinh)
+}
+pub(super) fn tanh(args: &[ArrayRef]) -> Result<ArrayRef> {
+    apply(args, tanh::tanh)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use arrow::array::{Array, Float64Array};
+    #[test]
+    fn preserves_nulls_slices_and_owned_output() {
+        type Kernel = fn(&[ArrayRef]) -> Result<ArrayRef>;
+        for (function, expected) in [
+            (cosh as Kernel, [1.0, 1.0, f64::INFINITY, f64::INFINITY]),
+            (
+                sinh as Kernel,
+                [-0.0, 0.0, f64::INFINITY, f64::NEG_INFINITY],
+            ),
+            (tanh as Kernel, [-0.0, 0.0, 1.0, -1.0]),
+        ] {
+            let input: ArrayRef = Arc::new(Float64Array::from(vec![
+                Some(99.0),
+                None,
+                Some(-0.0),
+                Some(0.0),
+                Some(f64::INFINITY),
+                Some(f64::NEG_INFINITY),
+            ]));
+            let result = function(&[input.slice(1, 5)]).unwrap();
+            drop(input);
+            let result = as_primitive_array::<Float64Type>(&result).unwrap();
+            assert_eq!(result.len(), 5);
+            assert!(result.is_null(0));
+            for (i, value) in expected.into_iter().enumerate() {
+                assert_eq!(result.value(i + 1).to_bits(), value.to_bits());
+            }
+            let empty: ArrayRef = Arc::new(Float64Array::from(Vec::<Option<f64>>::new()));
+            assert_eq!(function(&[empty]).unwrap().len(), 0);
+        }
+    }
+    #[test]
+    fn rejects_wrong_arity_and_type() {
+        assert!(cosh(&[]).is_err());
+        let values: ArrayRef = Arc::new(arrow::array::Int32Array::from(vec![1]));
+        assert!(tanh(&[values]).is_err());
+    }
+}
