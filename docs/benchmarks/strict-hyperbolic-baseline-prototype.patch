new file mode 100644
--- /dev/null
+++ b/native/engine/src/flink_functions/hyperbolic/cosh_sinh.rs
@@ -0,0 +1,63 @@
+// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
+// Developed at SunSoft, a Sun Microsystems, Inc. business.
+// Permission to use, copy, modify, and distribute this software is freely
+// granted, provided that this notice is preserved.
+// Adapted from original netlib fdlibm e_cosh.c and e_sinh.c.
+pub fn cosh(x: f64) -> f64 {
+    let magnitude = x.to_bits() & 0x7fff_ffff_ffff_ffff;
+    let high = (magnitude >> 32) as u32;
+    if high >= 0x7ff0_0000 {
+        return x * x;
+    }
+    let absolute = x.abs();
+    if high < 0x3fd6_2e43 {
+        let t = libm::expm1(absolute);
+        let w = 1.0 + t;
+        if high < 0x3c80_0000 {
+            return w;
+        }
+        return 1.0 + (t * t) / (w + w);
+    }
+    if high < 0x4036_0000 {
+        let t = libm::exp(absolute);
+        return 0.5 * t + 0.5 / t;
+    }
+    if high < 0x4086_2e42 {
+        return 0.5 * libm::exp(absolute);
+    }
+    if magnitude <= 0x4086_33ce_8fb9_f87d {
+        let w = libm::exp(0.5 * absolute);
+        let t = 0.5 * w;
+        return t * w;
+    }
+    f64::INFINITY
+}
+pub fn sinh(x: f64) -> f64 {
+    let magnitude = x.to_bits() & 0x7fff_ffff_ffff_ffff;
+    let high = (magnitude >> 32) as u32;
+    if high >= 0x7ff0_0000 {
+        return x + x;
+    }
+    let h = if x.is_sign_negative() { -0.5 } else { 0.5 };
+    let absolute = x.abs();
+    if high < 0x4036_0000 {
+        if high < 0x3e30_0000 {
+            return x;
+        }
+        let t = libm::expm1(absolute);
+        return if high < 0x3ff0_0000 {
+            h * (2.0 * t - t * t / (t + 1.0))
+        } else {
+            h * (t + t / (t + 1.0))
+        };
+    }
+    if high < 0x4086_2e42 {
+        return h * libm::exp(absolute);
+    }
+    if magnitude <= 0x4086_33ce_8fb9_f87d {
+        let w = libm::exp(0.5 * absolute);
+        let t = h * w;
+        return t * w;
+    }
+    f64::INFINITY.copysign(x)
+}
diff --git a/native/engine/src/flink_functions/hyperbolic/tanh.rs b/native/engine/src/flink_functions/hyperbolic/tanh.rs
new file mode 100644
--- /dev/null
+++ b/native/engine/src/flink_functions/hyperbolic/tanh.rs
@@ -0,0 +1,34 @@
+// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
+// Developed at SunSoft, a Sun Microsystems, Inc. business.
+// Permission to use, copy, modify, and distribute this software is freely
+// granted, provided that this notice is preserved.
+// Adapted from netlib fdlibm s_tanh.c, version 1.3 (1995-01-18).
+pub fn tanh(x: f64) -> f64 {
+    let high = (x.to_bits() >> 32) as u32;
+    let magnitude = high & 0x7fff_ffff;
+    let negative = high >> 31 != 0;
+    if magnitude >= 0x7ff0_0000 {
+        return if negative {
+            1.0 / x - 1.0
+        } else {
+            1.0 / x + 1.0
+        };
+    }
+    if magnitude < 0x3c80_0000 {
+        return x * (1.0 + x);
+    }
+    let result = if magnitude >= 0x4036_0000 {
+        1.0
+    } else if magnitude >= 0x3ff0_0000 {
+        let t = libm::expm1(2.0 * x.abs());
+        1.0 - 2.0 / (t + 2.0)
+    } else {
+        let t = libm::expm1(-2.0 * x.abs());
+        -t / (t + 2.0)
+    };
+    if negative {
+        -result
+    } else {
+        result
+    }
+}
diff --git a/native/engine/benches/hyperbolic_expressions.rs b/native/engine/benches/hyperbolic_expressions.rs
new file mode 100644
--- /dev/null
+++ b/native/engine/benches/hyperbolic_expressions.rs
@@ -0,0 +1,117 @@
+//! Production Calc evaluation against frozen Java 17 Math output bits.
+use arrow::array::{Array, ArrayRef, Float64Array, RecordBatch};
+use criterion::{criterion_group, criterion_main, BenchmarkId, Criterion, Throughput};
+use std::sync::Arc;
+use streamfusion::bench::CalcProgram;
+use streamfusion_benchmark_support::{header, measure, report, CountingAllocator};
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+fn fixtures() -> Vec<[u64; 4]> {
+    include_str!("hyperbolic_expressions/java17-oracle.csv")
+        .lines()
+        .skip(1)
+        .map(|line| {
+            let fields: Vec<_> = line
+                .split(',')
+                .map(|field| u64::from_str_radix(field, 16).unwrap())
+                .collect();
+            fields.try_into().unwrap()
+        })
+        .collect()
+}
+
+fn run(c: &mut Criterion) {
+    header();
+    let oracle = fixtures();
+    let mut group = c.benchmark_group("hyperbolic_expressions");
+    for (op, name, column) in [(166, "cosh", 1), (167, "sinh", 2), (168, "tanh", 3)] {
+        for rows in [0, 16, 1024, 16384] {
+            for nulls in [false, true] {
+                for offset in [0, 1, 5] {
+                    let values: ArrayRef =
+                        Arc::new(Float64Array::from_iter((0..rows + offset).map(|i| {
+                            (!(nulls && i % 7 == 0))
+                                .then(|| f64::from_bits(oracle[i % oracle.len()][0]))
+                        })));
+                    let input = values.slice(offset, rows);
+                    let batch = RecordBatch::try_from_iter([("value", input)]).unwrap();
+                    let mut plan = CalcProgram::new(
+                        vec![6, 11, 0],
+                        vec![op, 5, 0],
+                        vec![1, 1, 0],
+                        vec![],
+                        vec![],
+                        vec![],
+                    );
+                    let output = plan.run(batch.clone());
+                    let result = output
+                        .column(0)
+                        .as_any()
+                        .downcast_ref::<Float64Array>()
+                        .unwrap();
+                    assert_eq!(result.len(), rows);
+                    for i in 0..rows {
+                        let source = i + offset;
+                        assert_eq!(result.is_null(i), nulls && source % 7 == 0);
+                        if result.is_valid(i) {
+                            assert_eq!(
+                                result.value(i).to_bits(),
+                                oracle[source % oracle.len()][column],
+                                "{name}, row={i}, offset={offset}"
+                            );
+                        }
+                    }
+                    let label = format!("{name}/{rows}/nulls={nulls}/offset={offset}");
+                    let (output, allocations) = measure(|| plan.run(batch.clone()));
+                    report(&label, batch.columns(), output.columns(), allocations);
+                    group.throughput(Throughput::Elements(rows as u64));
+                    group.bench_function(BenchmarkId::from_parameter(label), |b| {
+                        b.iter(|| {
+                            std::hint::black_box(plan.run(std::hint::black_box(batch.clone())))
+                        });
+                    });
+                }
+            }
+            for bits in [0x3ff0_0000_0000_0000, 0x8000_0000_0000_0000] {
+                let reference = oracle.iter().find(|row| row[0] == bits).unwrap();
+                let batch = RecordBatch::try_from_iter([(
+                    "value",
+                    Arc::new(Float64Array::from(vec![0.0; rows])) as ArrayRef,
+                )])
+                .unwrap();
+                let mut plan = CalcProgram::new(
+                    vec![6, 11, 2],
+                    vec![op, 5, 0],
+                    vec![1, 1, 0],
+                    vec![],
+                    vec![f64::from_bits(bits)],
+                    vec![],
+                );
+                let output = plan.run(batch.clone());
+                let result = output
+                    .column(0)
+                    .as_any()
+                    .downcast_ref::<Float64Array>()
+                    .unwrap();
+                assert_eq!(result.len(), rows);
+                assert_eq!(result.null_count(), 0);
+                for value in result.values() {
+                    assert_eq!(value.to_bits(), reference[column]);
+                }
+                let label = format!("{name}/{rows}/scalar={bits:016x}");
+                let (output, allocations) = measure(|| plan.run(batch.clone()));
+                report(&label, batch.columns(), output.columns(), allocations);
+                group.throughput(Throughput::Elements(rows as u64));
+                group.bench_function(BenchmarkId::from_parameter(label), |b| {
+                    b.iter(|| std::hint::black_box(plan.run(std::hint::black_box(batch.clone()))));
+                });
+            }
+        }
+    }
+    group.finish();
+}
+
+criterion_group!(benches, run);
+criterion_main!(benches);
diff --git a/src/test/java/tech/streamfusion/FlinkHyperbolicSqlHarnessTest.java b/src/test/java/tech/streamfusion/FlinkHyperbolicSqlHarnessTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/tech/streamfusion/FlinkHyperbolicSqlHarnessTest.java
@@ -0,0 +1,105 @@
+package tech.streamfusion;
+
+import static org.apache.flink.table.api.DataTypes.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.apache.flink.table.api.TableEnvironment;
+import org.apache.flink.types.Row;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import tech.streamfusion.planner.NativePlanner;
+
+class FlinkHyperbolicSqlHarnessTest {
+  @Test
+  void decimalOperandsKeepSafeHostFallback() throws Exception {
+    NativeParity.assertFallback(
+        () -> BuiltinFunctionParity.environment(ROW(FIELD("x", DECIMAL(20, 9))),
+            java.util.Arrays.asList(Row.of(new java.math.BigDecimal("0.460000000")),
+                Row.of(new java.math.BigDecimal("-22.000000000")), Row.of((Object) null))),
+        "SELECT COSH(x), SINH(x), TANH(x) FROM src");
+  }
+
+  @Test
+  void unselectedBranchesAndFilteredRowsDoNotEvaluateFailures() throws Exception {
+    String failure = "CAST(1 / (id - id) AS DOUBLE)";
+    BuiltinFunctionParity.assertParity(FlinkHyperbolicSqlHarnessTest::input,
+        "SELECT id, CASE WHEN id >= 0 THEN COSH(d) ELSE COSH(" + failure + ") END, "
+            + "CASE WHEN id >= 0 THEN SINH(d) ELSE SINH(" + failure + ") END, "
+            + "CASE WHEN id >= 0 THEN TANH(d) ELSE TANH(" + failure + ") END FROM src");
+    BuiltinFunctionParity.assertParity(FlinkHyperbolicSqlHarnessTest::input,
+        "SELECT COSH(" + failure + "), SINH(" + failure + "), TANH(" + failure
+            + ") FROM src WHERE id < 0");
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"b", "s", "i", "l", "f", "d"})
+  void primitiveInputsMatchHostBitsAcrossBatches(String column) throws Exception {
+    String sql = "SELECT id, COSH(" + column + "), SINH(" + column + "), TANH(" + column + ") FROM src";
+    var host = input();
+    var nativeTable = input();
+    var scan = NativePlanner.install(nativeTable);
+    var schema = host.sqlQuery(sql).getResolvedSchema();
+    assertEquals(schema, nativeTable.sqlQuery(sql).getResolvedSchema());
+    for (int index = 1; index < 4; index++) {
+      assertEquals(DOUBLE(), schema.getColumnDataTypes().get(index));
+    }
+    var expected = collect(host, sql);
+    var actual = collect(nativeTable, sql);
+    assertTrue(scan.operatorTypes().stream().anyMatch(name -> name.contains("Calc")),
+        "No runtime native Calc: " + scan.operatorTypes());
+    assertEquals(5003, actual.size());
+    assertEquals(NativeParity.multiset(expected), NativeParity.multiset(actual), sql);
+    var sinkTable = input();
+    sinkTable.executeSql("CREATE TABLE sink (id INT, c DOUBLE, s DOUBLE, t DOUBLE) "
+        + "WITH ('connector' = 'blackhole')");
+    String plan = NativePlanner.explain(sinkTable, "INSERT INTO sink " + sql);
+    assertTrue(plan.contains("NativeCalc"), plan);
+    assertTrue(plan.contains("RowDataToArrow"), plan);
+    assertTrue(plan.contains("ArrowToRowData"), plan);
+  }
+
+  private static List<List<Object>> collect(TableEnvironment table, String sql) throws Exception {
+    List<List<Object>> rows = new ArrayList<>();
+    try (var iterator = table.executeSql(sql).collect()) {
+      while (iterator.hasNext()) {
+        Row row = iterator.next();
+        List<Object> values = new ArrayList<>();
+        values.add(row.getField(0));
+        for (int index = 1; index < 4; index++) {
+          Double value = (Double) row.getField(index);
+          values.add(value == null ? null : Double.doubleToRawLongBits(value));
+        }
+        rows.add(values);
+      }
+    }
+    return rows;
+  }
+
+  private static TableEnvironment input() {
+    double[] samples = {0.0, -0.0, 1.0, -1.0, 0.269864, 0.5, -0.5,
+        Math.nextDown(1.0), Math.nextUp(1.0), 22.0, -22.0,
+        Math.scalb(1.0, -55), Math.scalb(1.0, -28), Double.MIN_VALUE,
+        -Double.MIN_VALUE, Double.MIN_NORMAL, Double.MAX_VALUE, -Double.MAX_VALUE,
+        709.782712893384, 710.4758600739439, -710.4758600739439,
+        Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NaN};
+    List<Row> rows = new ArrayList<>();
+    for (int id = 0; id < 5003; id++) {
+      if (id % 29 == 0) {
+        rows.add(Row.of(id, null, null, null, null, null, null));
+      } else {
+        double value = samples[id % samples.length];
+        rows.add(Row.of(id, (byte) (id % 256 - 128), (short) (id * 31),
+            id % 3 == 0 ? Integer.MIN_VALUE : id % 3 == 1 ? Integer.MAX_VALUE : id - 2500,
+            id % 3 == 0 ? Long.MIN_VALUE : id % 3 == 1 ? Long.MAX_VALUE : (long) id - 2500,
+            (float) value, value));
+      }
+    }
+    return BuiltinFunctionParity.environment(
+        ROW(FIELD("id", INT()), FIELD("b", TINYINT()), FIELD("s", SMALLINT()),
+            FIELD("i", INT()), FIELD("l", BIGINT()), FIELD("f", FLOAT()), FIELD("d", DOUBLE())),
+        rows);
+  }
+}
