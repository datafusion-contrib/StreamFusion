@@ -0,0 +1,45 @@
+import java.util.LinkedHashSet;
+import java.util.Locale;
+import java.util.Random;
+
+public final class StrictHyperbolicOracle {
+  public static void main(String[] args) {
+    if (Runtime.version().feature() != 17) {
+      throw new IllegalStateException("Generate the reference with released Java 17");
+    }
+    var inputs = new LinkedHashSet<Long>();
+    double[] boundaries = {
+      0.0, Double.MIN_VALUE, Double.MIN_NORMAL, Math.scalb(1.0, -55),
+      Math.scalb(1.0, -28), Math.scalb(1.0, -26), 0.34657359027997265,
+      0.6931471805599453, 1.0, 22.0, 709.0, 709.782712893384,
+      710.0, 710.4758600739439, Double.MAX_VALUE, Double.POSITIVE_INFINITY
+    };
+    for (double boundary : boundaries) {
+      for (double sign : new double[] {1.0, -1.0}) {
+        long center = Double.doubleToRawLongBits(boundary * sign);
+        for (long offset = -4; offset <= 4; offset++) inputs.add(center + offset);
+      }
+    }
+    for (long bits : new long[] {
+        0x7ff8000000000000L, 0xfff8000000000000L,
+        0x7ff0000000000001L, 0xfff0000000000001L}) inputs.add(bits);
+    for (long value : new long[] {Long.MIN_VALUE, Long.MAX_VALUE, Integer.MIN_VALUE,
+        Integer.MAX_VALUE, -129, -128, -1, 0, 1, 127, 128}) {
+      inputs.add(Double.doubleToRawLongBits((double) value));
+    }
+    var random = new Random(236);
+    for (int i = 0; i < 8192; i++) {
+      inputs.add(random.nextLong());
+      inputs.add(Double.doubleToRawLongBits(random.nextDouble() * 1500.0 - 750.0));
+      inputs.add(Double.doubleToRawLongBits((double) Float.intBitsToFloat(random.nextInt())));
+    }
+    System.out.println("input_bits,cosh_bits,sinh_bits,tanh_bits");
+    for (long bits : inputs) {
+      double value = Double.longBitsToDouble(bits);
+      System.out.printf(Locale.ROOT, "%016x,%016x,%016x,%016x%n", bits,
+          Double.doubleToRawLongBits(Math.cosh(value)),
+          Double.doubleToRawLongBits(Math.sinh(value)),
+          Double.doubleToRawLongBits(Math.tanh(value)));
+    }
+  }
+}
