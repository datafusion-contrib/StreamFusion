  "feature": "Generic FIRST_VALUE/LAST_VALUE values on released Flink 2.2",
  "configuration": {
    "runtime": "JDK 17; release+mimalloc; Linux x86_64",
    "parallelism": 1,
    "heap": "2 GiB",
    "backend": "memory",
    "keys": 64,
    "cardinality": 1024,
