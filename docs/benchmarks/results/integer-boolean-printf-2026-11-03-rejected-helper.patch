+
+// Keep this extension out of the existing numeric dispatch's inlined branches.
+#[inline(never)]
+fn integer_boolean(conversion: u8, arg: &ArrayRef) -> Option<&'static str> {
+    // Formatter treats any non-NULL boxed integer, including zero, as true.
+    (matches!(conversion, b'b' | b'B')
+        && matches!(
+            arg.data_type(),
+            DataType::Int8 | DataType::Int16 | DataType::Int32 | DataType::Int64
+        ))
+    .then_some("true")
 }
 
