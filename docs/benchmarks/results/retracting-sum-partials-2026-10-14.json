{
  "boundary": "Whole bounded Flink SQL cascade, runtime rowwise source, both production transposes, keyed state, rowwise blackhole sink. Fixture and plan creation excluded; executeSql/await included. Actual candidate consumes rows in two local and two global native group aggregations. Prior enables planner but has zero substitutions and explicit SUM_RETRACT fallback.",
  "date": "2026-10-14",
  "sdk": "Released Apache Flink2.2.1, JDK17, Java release11",
  "base": "74822fd4109fe6fc54ddfdf336617c9c16eeed17",
  "config": {
    "parallelism": 1,
    "keys": 128,
    "outer_keys": 16,
    "mini_batch_size": 512,
    "mini_batch_allow_latency": "1h",
    "warmup_per_engine": 2,
    "measured_trials_per_engine": 3,
    "maximum_java_heap": "8g",
    "order": "alternating engine first by trial",
    "source": "fromSequence; INT/BIGINT value=i-rows/2, NULL every seventh row",
    "query": "SELECT u,SUM(mx),COUNT(mx),AVG(mx),SUM(mx) FILTER(WHERE mx>0) FROM(SELECT k,u,MAX(v) mx FROM src GROUP BY k,u) GROUP BY u",
    "task_off_heap_reservation": "48g"
  },
