+  @ParameterizedTest
+  @ValueSource(booleans = {false, true})
+  void reservedPrimitiveEntryOwnsReusedRowsAndPreservesBitsAcrossBatches(boolean objectReuse)
+      throws Exception {
+    var schema = RowType.of(new org.apache.flink.table.types.logical.TinyIntType(),
+        new org.apache.flink.table.types.logical.SmallIntType(), new IntType(), new BigIntType(),
+        new org.apache.flink.table.types.logical.FloatType(),
+        new org.apache.flink.table.types.logical.DoubleType());
+    List<GenericRowData> expected = List.of(
+        GenericRowData.of(Byte.MIN_VALUE, Short.MIN_VALUE, Integer.MIN_VALUE, Long.MIN_VALUE,
+            Float.intBitsToFloat(0x7fc00023), Double.longBitsToDouble(0x7ff8000000000023L)),
+        new GenericRowData(6),
+        GenericRowData.of((byte) 0, (short) 0, 0, 0L, -0.0f, -0.0d),
+        GenericRowData.of(Byte.MAX_VALUE, Short.MAX_VALUE, Integer.MAX_VALUE, Long.MAX_VALUE,
+            Float.NEGATIVE_INFINITY, Double.POSITIVE_INFINITY),
+        GenericRowData.of((byte) -1, (short) -1, -1, -1L,
+            Float.intBitsToFloat(0xffc00023), Double.longBitsToDouble(0xfff8000000000023L)),
+        GenericRowData.of((byte) 1, (short) 1, 1, 1L, Float.MIN_VALUE, Double.MIN_VALUE));
+    var kinds = org.apache.flink.types.RowKind.values();
+    for (int i = 0; i < expected.size(); i++) expected.get(i).setRowKind(kinds[i % kinds.length]);
+    List<RowData> retained = new ArrayList<>();
+    try (var harness = new OneInputStreamOperatorTestHarness<RowData, ArrowBatch>(
+        new RowDataToArrowOperator(schema, 2, false, null))) {
+      if (objectReuse) harness.getExecutionConfig().enableObjectReuse();
+      harness.setup(new ArrowBatchSerializer());
+      harness.open();
+      var reused = new GenericRowData(6);
+      for (var row : expected) {
+        for (int field = 0; field < 6; field++) reused.setField(field, row.getField(field));
+        reused.setRowKind(row.getRowKind());
+        harness.processElement(new StreamRecord<>(reused));
+        for (int field = 0; field < 6; field++) reused.setField(field, null);
+      }
+      List<ArrowBatch> batches = values(harness);
+      assertEquals(3, batches.size());
+      for (var batch : batches) {
+        try (var root = batch.root()) {
+          retained.addAll(RowDataArrowConverter.read(root, schema));
+        }
+      }
+    }
+    assertEquals(expected.size(), retained.size());
+    for (int i = 0; i < expected.size(); i++) {
+      var input = expected.get(i);
+      var output = retained.get(i);
+      assertEquals(input.getRowKind(), output.getRowKind());
+      for (int field = 0; field < 6; field++) {
+        assertEquals(input.isNullAt(field), output.isNullAt(field));
+      }
+      if (input.isNullAt(0)) continue;
+      assertEquals(input.getByte(0), output.getByte(0));
+      assertEquals(input.getShort(1), output.getShort(1));
+      assertEquals(input.getInt(2), output.getInt(2));
+      assertEquals(input.getLong(3), output.getLong(3));
+      assertEquals(Float.floatToRawIntBits(input.getFloat(4)),
+          Float.floatToRawIntBits(output.getFloat(4)));
+      assertEquals(Double.doubleToRawLongBits(input.getDouble(5)),
+          Double.doubleToRawLongBits(output.getDouble(5)));
+    }
+  }
