<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>streamfusion-kafka${streamfusion.artifact.suffix}</artifactId>
    <name>StreamFusion Kafka</name>

    <properties>
        <native.cargo.packages>-p streamfusion-kafka</native.cargo.packages>
        <native.library>streamfusion_kafka</native.library>
        <native.resource.path>tech/streamfusion/native/kafka</native.resource.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources combine.self="override">
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${native.resource.directory}</directory>
                <targetPath>${native.resource.path}</targetPath>
                <includes>
                    <include>lib${native.library}.so</include>
                    <include>lib${native.library}.dylib</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions><execution>
                    <id>flink-compatibility-sources</id>
                    <phase>generate-sources</phase>
                    <goals><goal>add-source</goal></goals>
                    <configuration><sources combine.self="override">
                        <source>${project.basedir}/src/main/java-flink${flink.line}</source>
                    </sources></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration><flattenMode>ossrh</flattenMode></configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Universal releases package the payloads staged for each supported platform. -->
    <profiles>
        <profile>
            <id>universal</id>
            <build>
                <resources>
                    <resource>
                        <directory>${project.basedir}/../native/target/universal/kafka</directory>
                        <targetPath>tech/streamfusion/native/kafka</targetPath>
                        <includes>
                            <include>**/libstreamfusion_kafka.so</include>
                            <include>**/libstreamfusion_kafka.dylib</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
