<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>tech.streamfusion</groupId>
    <artifactId>streamfusion-flink-suite-classpath</artifactId>
    <version>1.0-SNAPSHOT</version>
    <properties>
        <streamfusion.artifact.suffix></streamfusion.artifact.suffix>
        <flink.connector.kafka.version>5.0.0-2.2</flink.connector.kafka.version>
    </properties>
    <profiles>
        <profile>
            <id>flink-1.18</id>
            <properties>
                <streamfusion.artifact.suffix>-flink1.18</streamfusion.artifact.suffix>
                <flink.connector.kafka.version>3.2.0-1.18</flink.connector.kafka.version>
            </properties>
        </profile>
    </profiles>
    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-kafka${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-json${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-csv${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-raw${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-avro${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-avro-confluent-registry${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-protobuf${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-parquet${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-orc${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-paimon${streamfusion.artifact.suffix}</artifactId>
            <version>0.1.0-rc4</version>
        </dependency>
        <!-- StreamFusion discovers connector planner extensions at startup. Connector APIs are
             provided-scope in the production modules, so make Kafka's API explicit in this
             all-extensions test JVM even when the selected upstream suite is a file format. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${flink.connector.kafka.version}</version>
        </dependency>
    </dependencies>
</project>
