<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>streamfusion-canonical-savepoint-tests</artifactId>
    <name>Released Flink canonical savepoint fixtures</name>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <canonical.engine>native</canonical.engine>
        <canonical.suite>sql</canonical.suite>
        <canonical.connector.tests.artifact>flink-test-utils-connector</canonical.connector.tests.artifact>
        <canonical.upstream.tests>org.apache.flink.table.planner.plan.nodes.exec.stream.*RestoreTest#testRestore</canonical.upstream.tests>
        <canonical.agent.args>-javaagent:"${project.basedir}/../flink-suite/agent/target/streamfusion-flink-suite-agent-1.0-SNAPSHOT.jar" -Dstreamfusion.flink-suite.canonical=true -Dstreamfusion.flink-suite.flink-line=${flink.line} -Dstreamfusion.flink-suite.native-reports="${project.build.directory}/native-execution/${canonical.suite}"</canonical.agent.args>
        <canonical.classpath.exclude>unused:unused</canonical.classpath.exclude>
    </properties>
    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-runtime${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner_${scala.binary.version}</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-tests</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>${canonical.connector.tests.artifact}</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-statebackend-changelog</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-dstl-dfs</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.19.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-all</artifactId>
            <version>1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource><directory>${project.build.directory}/upstream/src/test/resources</directory></testResource>
        </testResources>
        <plugins>
            <!-- Only the runtime module builds and bundles StreamFusion's native libraries. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions><execution><id>build-native</id><phase>none</phase></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions><execution><id>copy-test-native-resource</id><phase>none</phase></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>canonical-savepoint-release-line</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration><rules><requireProperty><property>flink.line</property><regex>(1\.18|2\.2)</regex></requireProperty></rules></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>released-restore-fixtures</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>unpack</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.flink</groupId>
                                    <artifactId>flink-table-planner_${scala.binary.version}</artifactId>
                                    <version>${flink.version}</version>
                                    <classifier>tests</classifier>
                                    <includes>restore-tests/**</includes>
                                    <outputDirectory>${project.build.directory}/upstream/src/test/resources</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.flink</groupId>
                                    <artifactId>flink-tests</artifactId>
                                    <version>${flink.version}</version>
                                    <classifier>tests</classifier>
                                    <excludes>**/*.class,META-INF/**</excludes>
                                    <outputDirectory>${project.build.directory}/upstream/src/test/resources</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>false</skipTests>
                    <test>${canonical.upstream.tests}</test>
                    <dependenciesToScan>
                        <dependency>org.apache.flink:flink-table-planner_${scala.binary.version}</dependency>
                        <dependency>org.apache.flink:flink-tests</dependency>
                    </dependenciesToScan>
                    <classpathDependencyExcludes><classpathDependencyExclude>${canonical.classpath.exclude}</classpathDependencyExclude></classpathDependencyExcludes>
                    <workingDirectory>${project.build.directory}/upstream</workingDirectory>
                    <reportsDirectory>${project.build.directory}/reports/${canonical.engine}/${canonical.suite}</reportsDirectory>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <canonical.engine>${canonical.engine}</canonical.engine>
                        <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
                        <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                    </systemPropertyVariables>
                    <argLine>-Xmx4g -Dstreamfusion.native.development=true -Duser.timezone=UTC -Dio.netty.tryReflectionSetAccessible=true --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/java.time=ALL-UNNAMED --add-opens=java.base/java.math=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/sun.security.action=ALL-UNNAMED ${canonical.agent.args}</argLine>
                </configuration>
                <executions><execution><id>orc-tests</id><phase>none</phase></execution></executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>flink-1.18</id>
            <properties>
                <!-- 1.18 predates the released SQL RestoreTest framework. -->
                <canonical.upstream.tests>org.apache.flink.test.state.HeapSavepointStateBackendSwitchTest,org.apache.flink.test.state.RocksSavepointStateBackendSwitchTest</canonical.upstream.tests>
                <canonical.suite>runtime</canonical.suite>
                <canonical.connector.tests.artifact>flink-connector-test-utils</canonical.connector.tests.artifact>
            </properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration><testExcludes><testExclude>**/*RestoreTest.java</testExclude></testExcludes></configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>canonical-stock</id>
            <properties>
                <canonical.engine>stock</canonical.engine>
                <canonical.agent.args/>
                <canonical.classpath.exclude>tech.streamfusion:streamfusion-runtime${streamfusion.artifact.suffix}</canonical.classpath.exclude>
            </properties>
        </profile>
    </profiles>
</project>
