<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>streamfusion-orc${streamfusion.artifact.suffix}</artifactId>
    <name>StreamFusion Orc</name>
    <properties>
        <native.cargo.packages>-p streamfusion-orc</native.cargo.packages>
        <native.library>streamfusion_orc</native.library>
        <native.resource.path>tech/streamfusion/native/orc</native.resource.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId><artifactId>flink-orc</artifactId>
            <version>${flink.version}</version><scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources combine.self="override">
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${native.resource.directory}</directory>
                <targetPath>${native.resource.path}</targetPath>
                <includes>
                    <include>lib${native.library}.so</include>
                    <include>lib${native.library}.dylib</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions><execution>
                    <id>flink-compatibility-sources</id>
                    <phase>none</phase>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration><flattenMode>ossrh</flattenMode></configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Universal releases package the payloads staged for each supported platform. -->
    <profiles>
        <profile>
            <id>orc-writer-bench</id>
            <properties>
                <native.cargo.args>build --release --features mimalloc,writer-comparison</native.cargo.args>
            </properties>
        </profile>
        <profile>
            <id>orc-reader-bench</id>
            <properties>
                <native.cargo.args>build --release --features mimalloc,reader-comparison</native.cargo.args>
            </properties>
        </profile>
        <profile>
            <id>universal</id>
            <build>
                <resources>
                    <resource>
                        <directory>${project.basedir}/../native/target/universal/orc</directory>
                        <targetPath>tech/streamfusion/native/orc</targetPath>
                        <includes>
                            <include>**/libstreamfusion_orc.so</include>
                            <include>**/libstreamfusion_orc.dylib</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
