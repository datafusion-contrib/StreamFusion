<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>streamfusion-iceberg${streamfusion.artifact.suffix}</artifactId>
    <name>StreamFusion Iceberg</name>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <native.cargo.packages>-p streamfusion-iceberg</native.cargo.packages>
        <native.library>streamfusion_iceberg</native.library>
        <native.resource.path>tech/streamfusion/native/iceberg</native.resource.path>
        <native.test.resource.skip>true</native.test.resource.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.apache.hadoop</groupId><artifactId>hadoop-hdfs-client</artifactId>
            <version>3.3.4</version><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-flink-runtime-2.2</artifactId>
            <version>${iceberg.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>3.3.4</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-log4j12</artifactId></exclusion>
                <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <resources combine.self="override">
            <resource><directory>${project.basedir}/..</directory><targetPath>META-INF</targetPath>
                <includes><include>LICENSE</include></includes>
            </resource>
            <resource><directory>src/main/resources</directory></resource>
            <resource><directory>${native.resource.directory}</directory><targetPath>${native.resource.path}</targetPath>
                <includes><include>libstreamfusion_iceberg.so</include><include>libstreamfusion_iceberg.dylib</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <configuration><includes><include>tech/streamfusion/iceberg/**/*.java</include><include>tech/streamfusion/planner/*Iceberg*.java</include></includes></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution><id>iceberg-flink-line</id><goals><goal>enforce</goal></goals><configuration><rules>
                        <requireProperty><property>flink.line</property><regex>2\.2</regex><message>The released Iceberg adapter targets Flink 2.2 only.</message></requireProperty>
                    </rules></configuration></execution>
                    <execution><id>java-11-compatibility</id><configuration><rules>
                    <requireJavaVersion><version>[17,)</version></requireJavaVersion>
                    <enforceBytecodeVersion><maxJdkVersion>17</maxJdkVersion></enforceBytecodeVersion>
                </rules></configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>flatten-maven-plugin</artifactId>
                <configuration><flattenMode>ossrh</flattenMode></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>universal</id>
            <build><resources>
                <resource>
                    <directory>${project.basedir}/../native/target/universal/iceberg</directory>
                    <targetPath>${native.resource.path}</targetPath>
                    <includes>
                        <include>**/libstreamfusion_iceberg.so</include>
                        <include>**/libstreamfusion_iceberg.dylib</include>
                    </includes>
                </resource>
            </resources></build>
        </profile>
        <profile><id>iceberg-nexmark</id><dependencies>
            <dependency><groupId>tech.streamfusion</groupId><artifactId>streamfusion-kafka${streamfusion.artifact.suffix}</artifactId><version>${project.version}</version><scope>test</scope></dependency>
            <dependency><groupId>tech.streamfusion</groupId><artifactId>streamfusion-json${streamfusion.artifact.suffix}</artifactId><version>${project.version}</version><scope>test</scope></dependency>
            <dependency><groupId>tech.streamfusion</groupId><artifactId>streamfusion-core${streamfusion.artifact.suffix}</artifactId><version>${project.version}</version><type>test-jar</type><scope>test</scope></dependency>
        </dependencies><build><plugins>
            <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><executions>
                <execution><id>iceberg-nexmark-sources</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals><configuration><sources><source>${project.basedir}/src/iceberg-nexmark/java</source></sources></configuration></execution>
            </executions></plugin>
        </plugins></build></profile>
        <profile>
            <id>iceberg-upstream</id>
            <dependencies>
                <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><version>4.11.0</version><scope>test</scope></dependency>
                <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><version>4.3.0</version><scope>test</scope></dependency>

                <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-flink-2.2</artifactId><version>${iceberg.version}</version><type>test-jar</type><scope>test</scope></dependency>
                <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-api</artifactId><version>${iceberg.version}</version><type>test-jar</type><scope>test</scope></dependency>
                <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-data</artifactId><version>${iceberg.version}</version><type>test-jar</type><scope>test</scope></dependency>
                <dependency><groupId>org.apache.iceberg</groupId><artifactId>iceberg-core</artifactId><version>${iceberg.version}</version><type>test-jar</type><scope>test</scope></dependency>
                <dependency><groupId>org.apache.flink</groupId><artifactId>flink-metrics-dropwizard</artifactId><version>${flink.version}</version><scope>test</scope></dependency>
            </dependencies>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version>
                <configuration>
                    <dependenciesToScan><dependency>org.apache.iceberg:iceberg-flink-2.2:test-jar:tests</dependency></dependenciesToScan>
                    <includes>
                        <include>**/TestFlinkTableSinkExtended.class</include><include>**/TestIcebergSourceSql.class</include><include>**/TestDataStatisticsOperator.class</include><include>**/TestDataStatisticsCoordinator.class</include><include>**/TestRangePartitioner.class</include><include>**/TestDynamicIcebergSink.class</include><include>**/TestDynamicWriter.class</include><include>**/TestDynamicRecordProcessor.class</include><include>**/TestDynamicTableUpdateOperator.class</include><include>**/TestDynamicWriteResultAggregator.class</include><include>**/TestDynamicCommitter.class</include><include>**/TestDynamicCommittableSerializer.class</include><include>**/TestDynamicWriteResultSerializer.class</include><include>**/TestHashKeyGenerator.class</include><include>**/TestLRUCache.class</include>
                        <include>**/*Iceberg*Test.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <log4j.configurationFile>${project.basedir}/src/test/resources/log4j2-test.xml</log4j.configurationFile>
                        <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
                        <streamfusion.iceberg.suite.native>true</streamfusion.iceberg.suite.native>
                    </systemPropertyVariables>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.slf4j:slf4j-reload4j</classpathDependencyExclude>
                        <classpathDependencyExclude>org.slf4j:slf4j-log4j12</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
