<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>streamfusion-core</artifactId>
    <name>StreamFusion Core</name>

    <build>
        <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <excludes>
                        <exclude>tech/streamfusion/kafka/**</exclude>
                        <exclude>tech/streamfusion/fluss/**</exclude>
                        <exclude>tech/streamfusion/parquet/**</exclude>
                        <exclude>tech/streamfusion/format/avro/**</exclude>
                        <exclude>tech/streamfusion/format/avroconfluent/**</exclude>
                        <exclude>tech/streamfusion/format/csv/**</exclude>
                        <exclude>tech/streamfusion/format/json/**</exclude>
                        <exclude>tech/streamfusion/format/protobuf/**</exclude>
                        <exclude>tech/streamfusion/format/raw/**</exclude>
                        <exclude>tech/streamfusion/operator/NativeFileArrowBulkFormat.java</exclude>
                        <exclude>tech/streamfusion/operator/NativeParquetBulkWriterFactory.java</exclude>
                        <exclude>tech/streamfusion/operator/NativeParquetMetricSource.java</exclude>
                        <exclude>tech/streamfusion/operator/NativeParquetRollingPolicy.java</exclude>
                        <exclude>tech/streamfusion/operator/ParquetArrowBulkFormat.java</exclude>
                        <exclude>tech/streamfusion/operator/ParquetPartitionSplitOperator.java</exclude>
                        <exclude>tech/streamfusion/operator/ParquetSourceTimestamps.java</exclude>
                        <exclude>tech/streamfusion/planner/FlussPlannerExtension.java</exclude>
                        <exclude>tech/streamfusion/planner/FlussTables.java</exclude>
                        <exclude>tech/streamfusion/planner/KafkaPlannerExtension.java</exclude>
                        <exclude>tech/streamfusion/planner/KafkaSinkMatcher.java</exclude>
                        <exclude>tech/streamfusion/planner/KafkaSinkTranslator.java</exclude>
                        <exclude>tech/streamfusion/planner/KafkaTables.java</exclude>
                        <exclude>tech/streamfusion/planner/KeyedDecodeSpec.java</exclude>
                        <exclude>tech/streamfusion/planner/NativeFlussSourceExecNode.java</exclude>
                        <exclude>tech/streamfusion/planner/NativeKafkaDecodeExecNode.java</exclude>
                        <exclude>tech/streamfusion/planner/NativeKafkaSinkExecNode.java</exclude>
                        <exclude>tech/streamfusion/planner/NativeParquetSinkExecNode.java</exclude>
                        <exclude>tech/streamfusion/planner/NativeParquetSourceExecNode.java</exclude>
                        <exclude>tech/streamfusion/planner/ParquetPlannerExtension.java</exclude>
                        <exclude>tech/streamfusion/planner/ParquetSinkMatcher.java</exclude>
                        <exclude>tech/streamfusion/planner/ParquetSinkTranslator.java</exclude>
                        <exclude>tech/streamfusion/planner/ParquetSourceMatcher.java</exclude>
                        <exclude>tech/streamfusion/planner/ProtobufDescriptors.java</exclude>
                        <exclude>tech/streamfusion/planner/StreamPhysicalNativeFlussSource.java</exclude>
                        <exclude>tech/streamfusion/planner/StreamPhysicalNativeKafkaDecode.java</exclude>
                        <exclude>tech/streamfusion/planner/StreamPhysicalNativeKafkaSink.java</exclude>
                        <exclude>tech/streamfusion/planner/StreamPhysicalNativeParquetSink.java</exclude>
                        <exclude>tech/streamfusion/planner/StreamPhysicalNativeParquetSource.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <!-- The loader copies this artifact during process-resources. Produce the
                         unshaded input before the core shade execution, then let shade replace
                         it in the same lifecycle phase. -->
                    <execution>
                        <id>default-jar</id>
                        <phase>process-classes</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <!-- Core replaces its main artifact with one shaded payload for the loader.
                         Disable the parent's optional `runtime` attachment: shading this already
                         shaded JAR a second time duplicates every Arrow/Jackson class. -->
                    <execution>
                        <id>attach-runtime-payload</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>shade-core-payload</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>runtime</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
